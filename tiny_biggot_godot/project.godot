; Engine configuration file.
; Tiny Biggot - Godot 4 port of the RPG Maker VX Ace original.
; Target: Godot 4.6.1 (Xogot 1.6 on iPad). Do not use 4.7+ features.

config_version=5

[application]

config/name="Tiny Biggot"
config/description="An original pixel dungeon roguelite (ported from RPG Maker VX Ace)."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon.png"

[autoload]

Meta="*res://scripts/core/meta.gd"
Img="*res://scripts/core/img.gd"
Snd="*res://scripts/core/snd.gd"
Keys="*res://scripts/core/keys.gd"
G="*res://scripts/game/game.gd"

[debug]

gdscript/warnings/integer_division=0
gdscript/warnings/narrowing_conversion=0
gdscript/warnings/unused_parameter=0

[display]

window/size/viewport_width=448
window/size/viewport_height=288
window/size/window_width_override=1344
window/size/window_height_override=864
window/stretch/mode="viewport"
window/stretch/aspect="keep"
window/stretch/scale_mode="integer"
window/handheld/orientation=0

[input_devices]

pointing/emulate_touch_from_mouse=false
pointing/emulate_mouse_from_touch=false

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=4

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
