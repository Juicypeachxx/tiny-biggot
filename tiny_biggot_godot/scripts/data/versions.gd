## The newest version: [number, name, tweaks].
static func newest() -> PackedStringArray:
	return String(LIST[0]).split("|")

## "V28 VERSION NAMES", for the title screen.
static func label() -> String:
	var v := newest()
	return "V%s %s" % [v[0], v[1].to_upper()]
